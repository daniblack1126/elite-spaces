# Google Apps Script web app (Deploy > Manage deployments > Web app URL)
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Any long random string. Must match the SITE_SECRET Script Property in Apps Script.
APPS_SCRIPT_SECRET=

# Signs the member login cookie. Any long random string.
SESSION_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_LINK=https://buy.stripe.com/YOUR_MONTHLY_LINK
STRIPE_FOUNDING_LINK=https://buy.stripe.com/YOUR_FOUNDING_LINK
